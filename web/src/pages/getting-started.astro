---
import { faTerminal, faMagic, faDownload, faRocket, faBook } from '@fortawesome/free-solid-svg-icons';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
---

<BaseLayout
  title="Getting Started - Install & Build Your First Armature API"
  description="Install Armature, scaffold a project with the CLI, and build your first Rust API: define a controller, inject a service with the DI container, and run the server."
  canonicalPath="/getting-started"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Getting Started', path: '/getting-started' },
  ]}
>
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-stone-900">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-4xl font-bold text-center text-white mb-12">Quick Start</h2>
      <div class="bg-stone-950 rounded-xl p-8 shadow-2xl overflow-x-auto border border-stone-800">
        <pre
          class="text-sm text-stone-300"><code class="language-rust">use armature::prelude::*;

// Injectable service
#[injectable]
#[derive(Default, Clone)]
struct UserService;

impl UserService &#123;
    fn get_users(&amp;self) -&gt; Vec&lt;String&gt; &#123;
        vec!["Alice".to_string(), "Bob".to_string()]
    &#125;
&#125;

// Controller with routes
#[controller("/api")]
#[derive(Default, Clone)]
struct UserController;

impl UserController &#123;
    #[get("/users")]
    async fn list() -&gt; Result&lt;Json&lt;Vec&lt;String&gt;&gt;, Error&gt; &#123;
        Ok(Json(vec!["Alice".to_string(), "Bob".to_string()]))
    &#125;
&#125;

// Module wires everything together
#[module(
    providers: [UserService],
    controllers: [UserController]
)]
#[derive(Default)]
struct AppModule;

#[tokio::main]
async fn main() &#123;
    let app = Application::create::&lt;AppModule&gt;().await;
    app.listen(3000).await.unwrap();
&#125;</code></pre>
      </div>
    </div>
  </section>

  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-stone-950">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-4xl font-bold text-center text-white mb-12">Installation</h2>

      <div class="space-y-8">
        <!-- CLI Installation (Recommended) -->
        <div class="bg-gradient-to-r from-rust-900/30 to-orange-900/30 p-6 rounded-xl border-2 border-rust-700">
          <div class="flex items-center mb-4">
            <span class="bg-rust-600 text-white text-xs font-bold px-2 py-1 rounded mr-3">RECOMMENDED</span>
            <h3 class="text-2xl font-bold text-white">
              <Icon icon={faTerminal} class="text-rust-400 mr-2" />
              Using Armature CLI
            </h3>
          </div>
          <p class="text-stone-400 mb-4">
            The CLI provides code generation, project scaffolding, and a development server with hot reloading.
          </p>
          <div class="bg-stone-950 rounded-lg p-6 overflow-x-auto border border-stone-800">
            <pre
              class="text-sm text-stone-300"><code><span class="text-stone-500"># Install the CLI</span>
cargo install armature-cli

<span class="text-stone-500"># Create a new project</span>
armature new my-api

<span class="text-stone-500"># Navigate and start development</span>
cd my-api
armature dev</code></pre>
          </div>
          <p class="mt-4 text-stone-400">
            Your server is now running at
            <code class="bg-stone-800 px-2 py-1 rounded text-rust-400">http://127.0.0.1:3000</code>
            with automatic rebuilding on file changes.
          </p>
        </div>

        <!-- Code Generation -->
        <div>
          <h3 class="text-2xl font-bold text-white mb-4">
            <Icon icon={faMagic} class="text-rust-400 mr-2" />
            Generate Code
          </h3>
          <div class="bg-stone-950 rounded-lg p-6 overflow-x-auto border border-stone-800">
            <pre
              class="text-sm text-stone-300"><code><span class="text-stone-500"># Generate a controller</span>
armature generate controller users

<span class="text-stone-500"># Generate a service</span>
armature generate service users

<span class="text-stone-500"># Generate a complete resource (controller + service + module)</span>
armature generate resource products --crud

<span class="text-stone-500"># Generate middleware and guards</span>
armature generate middleware auth
armature generate guard admin</code></pre>
          </div>
        </div>

        <!-- Manual Setup -->
        <div class="border-t border-stone-800 pt-8">
          <h3 class="text-2xl font-bold text-white mb-4">
            <Icon icon={faDownload} class="text-rust-400 mr-2" />
            Manual Setup
          </h3>
          <p class="text-stone-400 mb-4">Or add Armature directly to an existing project:</p>
          <div class="bg-stone-950 rounded-lg p-6 overflow-x-auto border border-stone-800">
            <pre
              class="text-sm text-stone-300"><code>[dependencies]
armature = "0.1"
tokio = &#123; version = "1.35", features = ["full"] &#125;</code></pre>
          </div>
        </div>

        <div>
          <h3 class="text-2xl font-bold text-white mb-4">
            <Icon icon={faRocket} class="text-rust-400 mr-2" />
            Run your app
          </h3>
          <div class="bg-stone-950 rounded-lg p-6 overflow-x-auto border border-stone-800">
            <pre
              class="text-sm text-stone-300"><code><span class="text-stone-500"># With CLI (recommended)</span>
armature dev

<span class="text-stone-500"># Or with cargo</span>
cargo run</code></pre>
          </div>
          <p class="mt-4 text-stone-400">
            Your server is now running at
            <code class="bg-stone-800 px-2 py-1 rounded text-rust-400">http://127.0.0.1:3000</code>
          </p>
        </div>

        <div>
          <h3 class="text-2xl font-bold text-white mb-4">
            <Icon icon={faBook} class="text-rust-400 mr-2" />
            Next Steps
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-gradient-to-br from-blue-900/30 to-blue-900/50 p-6 rounded-lg border border-blue-800">
              <h4 class="font-bold text-white mb-2">📖 Read the Documentation</h4>
              <p class="text-stone-400 text-sm mb-3">Explore comprehensive guides covering all framework features.</p>
              <a href={url('/docs')} class="text-rust-400 hover:text-rust-300 font-medium text-sm">
                Browse Documentation →
              </a>
            </div>

            <div class="bg-gradient-to-br from-green-900/30 to-green-900/50 p-6 rounded-lg border border-green-800">
              <h4 class="font-bold text-white mb-2">💻 Browse Examples</h4>
              <p class="text-stone-400 text-sm mb-3">Check out 30+ working examples covering all features.</p>
              <a
                href="https://github.com/quinnjr/armature/tree/develop/examples"
                target="_blank"
                rel="noopener noreferrer"
                class="text-rust-400 hover:text-rust-300 font-medium text-sm"
              >
                See Code Examples →
              </a>
            </div>

            <div class="bg-gradient-to-br from-purple-900/30 to-purple-900/50 p-6 rounded-lg border border-purple-800">
              <h4 class="font-bold text-white mb-2">🔐 Add Authentication</h4>
              <p class="text-stone-400 text-sm mb-3">Integrate JWT, OAuth2, or SAML authentication in minutes.</p>
              <a href={url('/docs/auth-guide')} class="text-rust-400 hover:text-rust-300 font-medium text-sm">
                Learn Authentication →
              </a>
            </div>

            <div class="bg-gradient-to-br from-orange-900/30 to-orange-900/50 p-6 rounded-lg border border-orange-800">
              <h4 class="font-bold text-white mb-2">🔥 Real-time Features</h4>
              <p class="text-stone-400 text-sm mb-3">Add WebSockets and Server-Sent Events for live updates.</p>
              <a href={url('/docs/websocket-sse')} class="text-rust-400 hover:text-rust-300 font-medium text-sm">
                Real-time Guide →
              </a>
            </div>

            <div class="bg-gradient-to-br from-pink-900/30 to-pink-900/50 p-6 rounded-lg border border-pink-800">
              <h4 class="font-bold text-white mb-2">♻️ Lifecycle Hooks</h4>
              <p class="text-stone-400 text-sm mb-3">Manage resources with NestJS-inspired lifecycle hooks.</p>
              <a href={url('/docs/lifecycle-hooks')} class="text-rust-400 hover:text-rust-300 font-medium text-sm">
                Lifecycle Management →
              </a>
            </div>

            <div class="bg-gradient-to-br from-yellow-900/30 to-yellow-900/50 p-6 rounded-lg border border-yellow-800">
              <h4 class="font-bold text-white mb-2">📊 Logging & Observability</h4>
              <p class="text-stone-400 text-sm mb-3">Structured logging with tracing, metrics, and OpenTelemetry.</p>
              <a href={url('/docs/logging-guide')} class="text-rust-400 hover:text-rust-300 font-medium text-sm">
                Setup Logging →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
