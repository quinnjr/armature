---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page Not Found - Armature">
  <section class="bg-stone-950 py-24 text-center min-h-[60vh] flex flex-col items-center justify-center px-6">
    <h1 class="text-5xl font-bold text-white mb-4">404</h1>
    <p class="text-stone-400 mb-8">This page could not be found. Redirecting you home…</p>
    <a href={url('/')} class="btn-rust">Back to Home</a>
  </section>
  <script is:inline define:vars={{ home: url('/') }}>
    setTimeout(() => {
      window.location.replace(home);
    }, 3000);
  </script>
</BaseLayout>
