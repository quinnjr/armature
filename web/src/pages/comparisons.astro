];

const nodejsFrameworks: BenchmarkData[] = [
  {
    name: 'Koa',
    color: '#22c55e',
    runtime: 'Node.js',
    plaintextRps: 42500,
    jsonRps: 37500,
    pathParamRps: 35000,
    postRps: 29000,
    latencyP50: 2.5,
    latencyP99: 8,
    memoryIdle: 32,
    memoryLoad: 90,
  },
  {
    name: 'Express',
    color: '#fbbf24',
    runtime: 'Node.js',
    plaintextRps: 37500,
    jsonRps: 32500,
    pathParamRps: 29000,
    postRps: 25000,
    latencyP50: 3,
    latencyP99: 10,
    memoryIdle: 40,
    memoryLoad: 115,
  },
  {
    name: 'NestJS',
    color: '#e11d48',
    runtime: 'Node.js',
    plaintextRps: 32500,
    jsonRps: 29000,
    pathParamRps: 25000,
    postRps: 21000,
    latencyP50: 3.5,
    latencyP99: 12,
    memoryIdle: 65,
    memoryLoad: 150,
  },
  {
    name: 'Next.js',
    color: '#000000',
    runtime: 'Node.js',
    plaintextRps: 27500,
    jsonRps: 23500,
    pathParamRps: 20000,
    postRps: 16500,
    latencyP50: 4,
    latencyP99: 15,
    memoryIdle: 85,
    memoryLoad: 180,
  },
];

// One pre-rendered panel per tab; a small client script toggles visibility.
const tabs = [
  { id: 'all', frameworks: [...rustFrameworks, ...nodejsFrameworks] },
  { id: 'rust', frameworks: rustFrameworks },
  { id: 'nodejs', frameworks: nodejsFrameworks },
].map((tab) => ({
  ...tab,
  maxRps: Math.max(...tab.frameworks.map((f) => f.plaintextRps)),
}));

function getBarWidth(value: number, max: number): number {
  return (value / max) * 100;
}

function formatNumber(num: number): string {
  if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
  if (num >= 1000) return (num / 1000).toFixed(0) + 'K';
  return num.toString();
}

function getRatioVsArmature(framework: BenchmarkData): string {
  if (framework.name === 'Armature') return '-';
  const armature = rustFrameworks.find((f) => f.name === 'Armature')!;

  const ratio = framework.plaintextRps / armature.plaintextRps;
  if (ratio > 1) {
    return `${ratio.toFixed(1)}x faster`;
  } else {
    return `${(1 / ratio).toFixed(1)}x slower`;
  }
}

// Internal micro-benchmark results (December 2024)
