<BaseLayout title="Framework Comparisons - Armature">
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-stone-900">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-4xl font-bold text-center text-white mb-6">Why Armature?</h2>
      <p class="text-xl text-center text-stone-400 mb-16 max-w-3xl mx-auto">
        Love the developer experience of NestJS or Express but want Rust's performance and safety? Armature brings
        familiar patterns to the Rust ecosystem.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- For Node.js Developers -->
        <div class="space-y-6">
          <h3 class="text-2xl font-bold text-white">Coming from Node.js?</h3>
          <p class="text-stone-400">
            If you've used <strong class="text-stone-200">NestJS</strong>, <strong class="text-stone-200"
              >Express</strong
            >, or <strong class="text-stone-200">Koa</strong>, you'll feel right at home with Armature's decorator-based
            approach and middleware system.
          </p>
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <span class="text-green-400 font-bold">✓</span>
              <div>
                <strong class="text-white">Like NestJS:</strong>
                <span class="text-stone-400"> Decorators, DI, modules, guards, interceptors</span>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-green-400 font-bold">✓</span>
              <div>
                <strong class="text-white">Like Express:</strong>
                <span class="text-stone-400"> Middleware chain, flexible routing, simple API</span>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-green-400 font-bold">✓</span>
              <div>
                <strong class="text-white">Like Koa:</strong>
                <span class="text-stone-400"> Async/await first, context objects, composable middleware</span>
              </div>
            </div>
          </div>
        </div>

        <!-- For Rust Developers -->
        <div class="space-y-6">
          <h3 class="text-2xl font-bold text-white">Evaluating Rust Frameworks?</h3>
          <p class="text-stone-400">
            Armature stands alongside <strong class="text-stone-200">Actix-web</strong>, <strong class="text-stone-200"
              >Rocket</strong
            >,
            <strong class="text-stone-200">Axum</strong>, and <strong class="text-stone-200">Warp</strong>
            but with a unique focus on Angular/NestJS-style architecture.
          </p>
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <span class="text-rust-400 font-bold">→</span>
              <div>
                <strong class="text-white">vs. Actix-web:</strong>
                <span class="text-stone-400"> Higher-level abstractions, built-in DI container</span>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-rust-400 font-bold">→</span>
              <div>
                <strong class="text-white">vs. Rocket:</strong>
                <span class="text-stone-400"> Module-based architecture, more enterprise features</span>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-rust-400 font-bold">→</span>
              <div>
                <strong class="text-white">vs. Axum:</strong>
                <span class="text-stone-400"> Decorator syntax, integrated auth/validation/caching</span>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-rust-400 font-bold">→</span>
              <div>
                <strong class="text-white">vs. Warp:</strong>
                <span class="text-stone-400"> Less combinator complexity, familiar MVC structure</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comprehensive Feature Comparison -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 bg-stone-950">
