---
import { faGithub } from '@fortawesome/free-brands-svg-icons';
import Icon from './Icon.astro';
import { url } from '../lib/url';

const currentYear = new Date().getFullYear();
---

<footer class="bg-stone-900 border-t border-stone-800">
  <div class="max-w-7xl mx-auto px-8 lg:px-12">
    <!-- Main Footer Content -->
    <div class="py-20 grid grid-cols-1 md:grid-cols-12 gap-12">
      <!-- Brand Column -->
      <div class="md:col-span-4">
        <a href={url('/')} class="flex items-center gap-3 mb-6">
          <img src={url('/assets/armature-logo.svg')} alt="Armature Logo" class="h-10 w-10" />
          <span class="text-2xl font-bold text-white">Armature</span>
        </a>
        <p class="text-stone-400 leading-relaxed mb-8">
          A modern, type-safe HTTP framework for Rust inspired by Angular and NestJS.
        </p>
        <a
          href="https://github.com/quinnjr/armature"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-stone-400 hover:text-rust-400 transition-colors"
        >
          <Icon icon={faGithub} />
          <span>View on GitHub</span>
        </a>
      </div>

      <!-- Links Columns -->
      <div class="md:col-span-2">
        <h4 class="text-sm font-semibold text-stone-300 uppercase tracking-wider mb-6">Documentation</h4>
        <ul class="space-y-4">
          <li>
            <a href={url('/getting-started')} class="text-stone-400 hover:text-rust-400 transition-colors">
              Getting Started
            </a>
          </li>
          <li>
            <a href={url('/docs')} class="text-stone-400 hover:text-rust-400 transition-colors"> Guides </a>
          </li>
          <li>
            <a
              href="https://docs.rs/armature"
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-400 hover:text-rust-400 transition-colors"
            >
              API Reference
            </a>
          </li>
          <li>
            <a
              href="https://github.com/quinnjr/armature/tree/develop/examples"
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-400 hover:text-rust-400 transition-colors"
            >
              Examples
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-sm font-semibold text-stone-300 uppercase tracking-wider mb-6">Resources</h4>
        <ul class="space-y-4">
          <li>
            <a href={url('/comparisons')} class="text-stone-400 hover:text-rust-400 transition-colors"> Comparisons </a>
          </li>
          <li>
            <a href={url('/faq')} class="text-stone-400 hover:text-rust-400 transition-colors"> FAQ </a>
          </li>
          <li>
            <a
              href="https://github.com/quinnjr/armature/blob/main/CHANGELOG.md"
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-400 hover:text-rust-400 transition-colors"
            >
              Changelog
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-sm font-semibold text-stone-300 uppercase tracking-wider mb-6">Community</h4>
        <ul class="space-y-4">
          <li>
            <a
              href="https://github.com/quinnjr/armature"
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-400 hover:text-rust-400 transition-colors"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href="https://github.com/quinnjr/armature/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-400 hover:text-rust-400 transition-colors"
            >
              Report Issue
            </a>
          </li>
          <li>
            <a
              href="https://github.com/quinnjr/armature/discussions"
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-400 hover:text-rust-400 transition-colors"
            >
              Discussions
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <h4 class="text-sm font-semibold text-stone-300 uppercase tracking-wider mb-6">Legal</h4>
        <ul class="space-y-4">
          <li>
            <a
              href="https://github.com/quinnjr/armature/blob/main/LICENSE"
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-400 hover:text-rust-400 transition-colors"
            >
              License (Apache 2.0)
            </a>
          </li>
          <li>
            <a
              href="https://github.com/quinnjr/armature/blob/main/.github/SECURITY.md"
              target="_blank"
              rel="noopener noreferrer"
              class="text-stone-400 hover:text-rust-400 transition-colors"
            >
              Security Policy
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="py-8 border-t border-stone-800 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-stone-500">© {currentYear} Joseph Quinn. All rights reserved.</p>
      <p class="text-stone-500 flex items-center gap-2">
        <span>Built with</span>
        <span class="text-rust-500">Rust</span>
        <span>·</span>
        <span>Astro</span>
        <span>·</span>
        <span>Tailwind CSS</span>
      </p>
    </div>
  </div>
</footer>
