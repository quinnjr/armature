---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { absolute, breadcrumbSchema, type Crumb } from '../lib/seo';
import { SOFTWARE_APPLICATION_SCHEMA, ORGANIZATION_SCHEMA, WEBSITE_SCHEMA } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Site-absolute path (without base) to canonicalize this page to, e.g. '/docs'. */
  canonicalPath?: string;
  /** Emit the site-describing SoftwareApplication schema (home page only). */
  richSchemas?: boolean;
  /** Breadcrumb trail for this page, root first. Omit on the home page. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD documents, already serialized. */
  schemas?: string[];
  /** Keep this page out of the index (error pages, thin placeholders). */
  noindex?: boolean;
  /** ISO-8601 last-modified, surfaced to crawlers as a freshness signal. */
  dateModified?: string;
  /** Open Graph type; 'article' for documentation pages. */
  ogType?: 'website' | 'article';
}

const DEFAULT_TITLE = 'Armature Framework - Enterprise Rust Web Framework | NestJS Alternative';
const DEFAULT_DESCRIPTION =
  'Armature is a batteries-included, enterprise-grade web framework for Rust inspired by NestJS and Angular. Build production-ready APIs with dependency injection, decorators, JWT/OAuth2 auth, and 150+ features.';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath,
  richSchemas = false,
  breadcrumbs,
  schemas = [],
  noindex = false,
  dateModified,
  ogType = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://quinnjr.github.io');
const canonical = new URL(canonicalPath ? url(canonicalPath) : Astro.url.pathname, site).href;
const ogImage = absolute('/og-image.png', site);

// Each page contributes its own trail; the site-wide schemas describe the site,
// and anything page-specific arrives through `schemas`.
const breadcrumbJson = breadcrumbs && breadcrumbs.length > 0 ? breadcrumbSchema(breadcrumbs, site) : null;

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <meta name="description" content={description} />
    <meta name="author" content="Joseph R. Quinn" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />

    <!--
      Open Graph. Title and description track the page rather than the site:
      every doc page previously produced an identical share card, and answer
      engines that read OG tags saw one description for the whole site.
    -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Armature Framework - Enterprise Rust Web Framework" />
    <meta property="og:site_name" content="Armature Framework" />
    <meta property="og:locale" content="en_US" />
    {dateModified && <meta property="article:modified_time" content={dateModified} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Armature Framework - Enterprise Rust Web Framework" />
    <meta name="twitter:creator" content="@quinnjr" />

    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- An AI-readable summary of the whole site, per llmstxt.org. -->
    <link rel="alternate" type="text/plain" href={url('/llms.txt')} title="LLM-readable site summary" />

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/x-icon" href={url('/favicon.ico')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/assets/icons/icon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={url('/assets/icons/icon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="theme-color" content="#CE422B" />
    <meta name="msapplication-TileColor" content="#CE422B" />

    <!-- Preconnect for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://github.com" />

    <!-- Google Fonts - Inter & Fira Code -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data / JSON-LD for Search Engines and LLMs -->
    <script type="application/ld+json" set:html={ORGANIZATION_SCHEMA} />
    <script type="application/ld+json" set:html={WEBSITE_SCHEMA} />
    {richSchemas && <script type="application/ld+json" set:html={SOFTWARE_APPLICATION_SCHEMA} />}
    {breadcrumbJson && <script type="application/ld+json" set:html={breadcrumbJson} />}
    {schemas.map((schema) => <script type="application/ld+json" set:html={schema} />)}
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
