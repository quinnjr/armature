{
  "name": "armature-web",
  "version": "0.1.0",
  "description": "Documentation website for Armature Framework",
  "author": "Pegasus Heavy Industries LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pegasusheavy/armature.git"
  },
  "homepage": "https://pegasusheavy.github.io/armature",
  "type": "module",
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "build": "astro build",
    "build:prod": "astro build",
    "build:gh-pages": "ASTRO_BASE=/armature astro build",
    "preview": "astro preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,astro}\"",
    "lint:fix": "eslint \"src/**/*.{ts,astro}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,astro,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,astro,css,scss,json}\"",
    "ci": "pnpm run lint && pnpm run format:check && pnpm run test:ci && pnpm run build:prod"
  },
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@pegasusheavy/tailswatch": "^1.5.0",
    "astro": "^5.16.0",
    "marked": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.83.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.1.0"
  }
}
