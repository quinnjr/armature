{
  "name": "armature-web",
  "version": "0.1.0",
  "description": "Documentation website for Armature Framework",
  "author": "Joseph Quinn <quinn.josephr@proton.me>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/quinnjr/armature.git"
  },
  "homepage": "https://quinnjr.github.io/armature",
  "type": "module",
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "build": "astro build",
    "build:prod": "astro build",
    "build:gh-pages": "ASTRO_BASE=/armature astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,astro}\"",
    "lint:fix": "eslint \"src/**/*.{ts,astro}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,astro,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,astro,css,scss,json}\"",
    "ci": "pnpm run lint && pnpm run format:check && pnpm run test:ci && pnpm run build:prod"
  },
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "astro": "^5.16.0",
    "marked": "^18.0.0",
    "sanitize-html": "^2.17.6",
    "tailswatch": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.103.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
